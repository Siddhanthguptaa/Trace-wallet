# Copy to .env. Never put the owner's wallet seed here (IDEA section 7).

# local = anvil + locally deployed EntryPoint v0.8 + MockUSDC3009
# fork  = anvil fork of Base at FORK_BLOCK with real USDC and the canonical EntryPoint v0.8
CHAIN_MODE=local
ANVIL_PORT=8545

# RPCs (checked in M0: chainId 8453 and 84532)
BASE_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Pinned Base block for fork tests (M0, results/toolchain.json#forkBlock)
FORK_BLOCK=53026000

# Canonical addresses (BUILD.md Machine check)
ENTRYPOINT_V08=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# LLM shooter: any OpenAI-compatible endpoint (default: local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b

# Optional: folder holding forge/anvil/cast if they are not on PATH
# FOUNDRY_BIN=C:\Users\you\.foundry\bin

# The REAL-CHAIN MetaMask demo (Base Sepolia) has its own file: .env.live.example -> .env.live (generated by
# `pnpm exec tsx scripts/live/live.ts init --owner 0x<your MetaMask address>`). Nothing here is used by it.
