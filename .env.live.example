# ===========================================================================================
# .env.live.example  --  configuration of the REAL-CHAIN MetaMask demo (scripts/live/live.ts)
#
# `pnpm exec tsx scripts/live/live.ts init --owner 0xYourMetaMaskAddress` COPIES this file to
# `.env.live` (git-ignored) and fills in the generated values. Edit `.env.live`, never this file.
#
# SECURITY RULES
#  * Everything below is a THROWAWAY TESTNET secret, except the OWNER, which is only a PUBLIC address.
#  * The OWNER's private key / seed phrase lives in MetaMask and NEVER appears in any env file, script
#    or log. The owner signs every owner action in the MetaMask popup.
#  * No mocks on the live path: real Base Sepolia, real Circle test USDC, real EntryPoint v0.8, and the
#    real attestor / approval / watcher services running as processes (`live.ts services up`).
#  * Base MAINNET is refused unless every command gets --allow-mainnet (the contracts are unaudited;
#    keep at most ~1 USDC in the account).
# ===========================================================================================

# ---- network ------------------------------------------------------------------------------
# base-sepolia = the demo. (anvil is used only by `rehearse.ts`, the pre-flight test.)
CHAIN=base-sepolia
CHAIN_ID=84532
# Public Base Sepolia RPC. If it rate-limits you, put an Alchemy / Infura / QuickNode URL here.
RPC_URL=https://sepolia.base.org
# Block explorer used for the links the CLI and the console print.
EXPLORER_URL=https://sepolia.basescan.org
# EntryPoint v0.8 (canonical, deterministic address on every chain).
ENTRYPOINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
# Circle test USDC on Base Sepolia (FiatTokenV2_2: EIP-3009 transferWithAuthorization, EIP-2612 permit).
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_DECIMALS=6

# ---- the owner: PUBLIC ADDRESS ONLY (MetaMask) -------------------------------------------
# The MetaMask account that owns the agent account and signs owner transactions / approvals.
OWNER_ADDRESS=

# ---- throwaway keys (generated by `live.ts init`; testnet only) ---------------------------
# Deploys the contracts and relays UserOps (handleOps). Fund this address with ~0.02 Base Sepolia ETH.
DEPLOYER_KEY=
# The agent's session key: the key that gets LEAKED in the demo (`live.ts leak`). Holds no funds.
AGENT_KEY=
# The attestor's signing key: used by the REAL attestor service (services/attestor) to sign payee
# attestations. The `forged` attack uses it as the leaked attestor key.
ATTESTOR_KEY=
# The watcher's key: lets the REAL watcher service FREEZE the agent key (escalate-only, cannot unfreeze).
WATCHER_KEY=
# The attacker's identity (receives stolen funds in the attacks). Needs no ETH.
ATTACKER_KEY=
# An outcome verifier for the attestor (non-interactive alternative to the owner vouching in MetaMask).
VERIFIER_KEY=
# Five guardians (3-of-5 recovery). Addresses go on-chain; keys are throwaway and let the CLI play
# guardians in the recovery demo.
GUARDIAN_ADDRESSES=
GUARDIAN_KEYS=
# A plain EOA the policy lists as the one trusted merchant (no mock shop contract). Replace it with any
# address you like; the agent's in-policy payments go here.
MERCHANT_ADDRESS=

# ---- the policy the owner installs (live.ts / the console read these) ---------------------
# Daily limit = DAILY_BURST_USDC + DAILY_RATE_USDC (burst now, refill per day): any 24 h window moves
# at most this much, with every detector OFF. Defaults give an 8 USDC daily limit, so a wallet funded
# with the faucet's 10 USDC shows the bound.
DAILY_BURST_USDC=4
DAILY_RATE_USDC=4
PER_TX_USDC=4
POLICY_DAYS=7
# EntryPoint deposit the account pays UserOp gas from, and the policy's gas credit.
DEPOSIT_ETH=0.003
GAS_CREDIT_ETH=0.02
# Freeze tripwires pinned on dev seeds (agent/hijack/thresholds.json): velocity bps of the daily cap,
# distinct unproven payees per hour, strikes per hour.
FREEZE_VELOCITY_BPS=6000
FREEZE_SPRAY_MAX=5
FREEZE_STRIKE_MAX=3

# ---- deployment (written by `live.ts deploy`; also in deployments/<chainId>.json) -----------
SALT=1
FACTORY=
IMPLEMENTATION=
ADMIN=
LENS=
# The agent account (counterfactual address from the factory; exists after the owner's createAccount).
ACCOUNT=

# ---- services (started by `live.ts services up`, real processes) -------------------------------
ATTESTOR_PORT=8789
APPROVAL_PORT=8788
WATCHER_PORT=8790
ATTESTOR_URL=http://127.0.0.1:8789
APPROVAL_URL=http://127.0.0.1:8788
WATCHER_URL=http://127.0.0.1:8790
# How often the watcher polls the chain (ms).
WATCHER_POLL_MS=3000

# ---- owner console ----------------------------------------------------------------------------
CONSOLE_PORT=8799
